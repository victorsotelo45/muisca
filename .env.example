# Copie este archivo como .env (no se versiona) y complete los valores.
# En Render estas mismas variables se definen en el panel de cada servicio.

# MySQL. En la nube (Aiven) agregue ?sslMode=REQUIRED&createDatabaseIfNotExist=true
DB_URL=jdbc:mysql://localhost:3306/muisca
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=10

# Google OAuth (Google Cloud Console > Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mínimo 64 caracteres aleatorios (HS512). Use uno distinto por entorno.
JWT_SECRET=

# Primer administrador (se crea solo si no existe ningún ADMIN)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Opcionales
# PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# JPA_SHOW_SQL=true
